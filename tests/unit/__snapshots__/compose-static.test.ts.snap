exports[`transform tools in the export: warps, pivot and blend modes (pinned) > blend modes: lut2 with the W3C formula (MP4); on a transparent WebM, Normal where nothing is behind (maskedmerge) 1`] = `"-protocol_whitelist file,pipe -ss 0.000 -t 6.000 -i /v.mp4 -loop 1 -framerate 30 -t 5.000 -i /p.png -ss 0.000 -t 6.000 -i /v.mp4 -filter_complex color=c=0x000000:s=1280x720:r=30:d=6.000,format=rgba[base];[0:v]setpts=PTS-STARTPTS,fps=30,scale=1280:720:flags=bicubic,format=rgba,setpts=PTS-STARTPTS+0.000/TB[v];[base][v]overlay=x=0:y=0:eof_action=pass:format=auto:enable='between(t\\,0.000\\,6.000)'[o];[1:v]scale=480:360:flags=bicubic,format=rgba,setpts=PTS-STARTPTS+1.000/TB[v_2];color=c=black@0:s=1280x720:r=30:d=6.000,format=rgba[lb];[lb][v_2]overlay=x=400:y=180:eof_action=pass:format=auto:enable='between(t\\,1.000\\,6.000)'[lc];[o]format=gbrap,split=2[cb][co];[lc]format=gbrap[ls];[cb][ls]lut2=c0='clip(round(255*((x/255)*(y/255)))\\,0\\,255)':c1='clip(round(255*((x/255)*(y/255)))\\,0\\,255)':c2='clip(round(255*((x/255)*(y/255)))\\,0\\,255)':c3='y':enable='between(t\\,1.000\\,6.000)'[bl];[co][bl]overlay=0:0:format=auto:enable='between(t\\,1.000\\,6.000)',format=rgba[bo];[bo]scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[vout];[2:a]asetpts=PTS-STARTPTS,aresample=48000,aformat=channel_layouts=stereo,volume=1.00[a];[a]amix=inputs=1:normalize=0:dropout_transition=0,atrim=0:6.000,asetpts=PTS-STARTPTS[aout] -map [vout] -c:v libx264 -preset medium -crf 23 -pix_fmt yuv420p -colorspace bt709 -color_primaries bt709 -color_trc bt709 -movflags +faststart -map [aout] -c:a aac -b:a 160k -t 6.000 -y /out.mp4"`;

