exports[`blank scenes: a color on Video 1, placed like a picture > video → blank (a crossfade into it) → video 1`] = `"-protocol_whitelist file,pipe -ss 0.000 -t 6.000 -i /v.mp4 -ss 0.000 -t 6.000 -i /v.mp4 -ss 0.000 -t 6.000 -i /v.mp4 -ss 0.000 -t 6.000 -i /v.mp4 -filter_complex color=c=0x000000:s=1280x720:r=30:d=14.500,format=rgba[base];[0:v]setpts=PTS-STARTPTS,fps=30,scale=1280:720:flags=bicubic,format=rgba,setpts=PTS-STARTPTS+0.000/TB[v];[base][v]overlay=x=0:y=0:eof_action=pass:format=auto:enable='between(t\\,0.000\\,6.000)'[o];color=c=0x112233:s=1280x720:r=30:d=3.000,format=rgba,fade=t=in:st=0:d=0.500:alpha=1,fade=t=out:st=2.700:d=0.300:alpha=1,setpts=PTS-STARTPTS+5.500/TB[v_2];[o][v_2]overlay=x=0:y=0:eof_action=pass:format=auto:enable='between(t\\,5.500\\,8.500)'[o_2];[1:v]setpts=PTS-STARTPTS,fps=30,scale=1280:720:flags=bicubic,format=rgba,setpts=PTS-STARTPTS+8.500/TB[v_3];[o_2][v_3]overlay=x=0:y=0:eof_action=pass:format=auto:enable='between(t\\,8.500\\,14.500)'[o_3];[o_3]scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[vout];[2:a]asetpts=PTS-STARTPTS,aresample=48000,aformat=channel_layouts=stereo,volume=1.00,afade=t=out:st=5.500:d=0.500[a];[3:a]asetpts=PTS-STARTPTS,aresample=48000,aformat=channel_layouts=stereo,volume=1.00,adelay=8500:all=1[a_2];[a][a_2]amix=inputs=2:normalize=0:dropout_transition=0,atrim=0:14.500,asetpts=PTS-STARTPTS[aout] -map [vout] -c:v libx264 -preset medium -crf 23 -pix_fmt yuv420p -colorspace bt709 -color_primaries bt709 -color_trc bt709 -movflags +faststart -map [aout] -c:a aac -b:a 160k -t 14.500 -y /out.mp4"`;

