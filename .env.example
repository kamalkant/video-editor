# ==============================================================================
# VDO Studio — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# On your own computer (`npm run dev`, http://localhost:<any port>) /login signs you into a local
# account (dev@localhost) in your local database: the website's sign-in can't reach localhost.
# Set LOCAL_DEV_ROLE=admin for an admin. Billing and admin pages are still on viplay.in.
# LOCAL_DEV_ROLE=admin

# ------------------------------------------------------------------------------
# Database Configuration (Dual-Engine)
# ------------------------------------------------------------------------------
# Optional: Set DATABASE_URL to connect to a PostgreSQL database.
# If omitted, VDO Studio automatically runs embedded SQLite (data/VDO.db) with zero config.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vdo_studio
# DATABASE_SSL=false

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Continue with Google)
# ------------------------------------------------------------------------------
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Email Delivery (Email Verification & Password Reset)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=ViPlay Studio <noreply@viplay.in>

# Option B: Standard SMTP (e.g. Amazon SES, Postmark, Mailgun, SendGrid)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# SMS Delivery (Continue with Phone — SMS OTP)
# ------------------------------------------------------------------------------
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# AI Studio & Model Keys (Local Editor AI Tools)
# ------------------------------------------------------------------------------
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=

# GEMINI_MODEL_TEXT=gemini-3.8-flash
# GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
# GEMINI_MODEL_TTS=gemini-3.8-flash-tts
# GEMINI_MODEL_VIDEO=veo-3.1-fast-generate-preview

# ------------------------------------------------------------------------------
# Stock Media Libraries (Free Videos & Photos)
# ------------------------------------------------------------------------------
# a free key at https://pixabay.com/api/docs/ (never put a real key in this file)
PIXABAY_API_KEY=
# PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# Local install only
# ------------------------------------------------------------------------------
# The editor on your own computer: also keep drafts in ~/Documents/VDO through this server.
# Never on a shared server (viplay.in): there every person's drafts would land in one folder.
# VDO_LOCAL_MODE=1

# Optional: refresh the Google Fonts list with the Developer API instead of fonts.google.com
# (node scripts/build-font-catalog.mjs)
# GOOGLE_FONTS_API_KEY=
